[Unit]
Description=GEV recurring metro Atlanta public place refresh
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ gev_account }}
Group={{ gev_account }}
WorkingDirectory={{ gev_source }}
Environment=PATH={{ gev_node }}/bin:/usr/bin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=GEV_PLACES_PYTHON=/opt/gev-places-venv/bin/python
Environment=GEV_PLACES_STATE_DIR=/var/lib/gods-eye-view/place-refresh
EnvironmentFile=/etc/gods-eye-view/storage.env
EnvironmentFile=/etc/gods-eye-view/gis-index.env
ExecStart={{ gev_node }}/bin/node {{ gev_source }}/scripts/place-refresh.mjs run
Restart=on-failure
RestartSec=60s
TimeoutStopSec=60s
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUQuota=100%
MemoryHigh=900M
MemoryMax=1200M
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gods-eye-view/place-refresh

[Install]
WantedBy=multi-user.target
