[Unit]
Description=GEV rolling Georgia GIS address and street index
Wants=network-online.target
After=network-online.target postgresql.service
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ gev_account }}
Group={{ gev_account }}
WorkingDirectory={{ gev_source }}
Environment=HOME=/var/lib/gods-eye-view
Environment=PATH={{ gev_node }}/bin:/usr/bin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=256
EnvironmentFile=/etc/gods-eye-view/storage.env
EnvironmentFile=/etc/gods-eye-view/gis-index.env
ExecStart={{ gev_node }}/bin/node {{ gev_source }}/scripts/gis-index.mjs run
Restart=on-failure
RestartSec=60s
TimeoutStopSec=60s
KillSignal=SIGTERM
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=384M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
